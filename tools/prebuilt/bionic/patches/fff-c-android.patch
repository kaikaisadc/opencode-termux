@@ -52,6 +59,43 @@ struct FffInstance {
     query_tracker: SharedQueryTracker,
 }
 
+// Raw mmap so the opaque handle lives in untagged memory (see instance_alloc).
+unsafe extern "C" {
+    fn mmap(
+        addr: *mut c_void,
+        length: usize,
+        prot: i32,
+        flags: i32,
+        fd: i32,
+        offset: i64,
+    ) -> *mut c_void;
+    fn munmap(addr: *mut c_void, length: usize) -> i32;
+}
+const PROT_READ: i32 = 1;
+const PROT_WRITE: i32 = 2;
+const MAP_PRIVATE: i32 = 0x02;
+const MAP_ANONYMOUS: i32 = 0x20;
+
+/// Move an instance into untagged anonymous mmap memory and return its pointer.
+unsafe fn instance_alloc(instance: FffInstance) -> *mut c_void {
+    let size = std::mem::size_of::<FffInstance>();
+    let p = unsafe {
+        mmap(
+            std::ptr::null_mut(),
+            size,
+            PROT_READ | PROT_WRITE,
+            MAP_PRIVATE | MAP_ANONYMOUS,
+            -1,
+            0,
+        )
+    };
+    if p.is_null() || p as isize == -1 {
+        return std::ptr::null_mut();
+    }
+    unsafe { std::ptr::write(p as *mut FffInstance, instance) };
+    p
+}
