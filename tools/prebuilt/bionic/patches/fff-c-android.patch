+// Android: scudo returns top-byte-tagged heap pointers (>2^53). FFI runtimes that
+// surface pointers as JS numbers (bun:ffi `read.ptr`) lose precision, so route all
+// allocations through mimalloc, whose mmap-backed pointers are untagged.
+#[cfg(feature = "mimalloc")]
+#[global_allocator]
+static GLOBAL: mimalloc::MiMalloc = mimalloc::MiMalloc;
+
 mod accessors;
